<!-- Reference:
https://github.com/ros/urdf_sim_tutorial -->

<launch>

  <arg name="gui" default="true"/>
  <arg name="server" default="true"/>
  <arg name="pause" default="false"/>
  <arg name="record" default="false"/>

  <!---->

  <!-- Add our project workspace to Gazebo index to load custom models -->
  <set_env name="GAZEBO_RESOURCE_PATH" value="$(find-pkg-share perse_simulation)"/>
  <set_env name="GAZEBO_MODEL_PATH" value="$(find-pkg-share perse_simulation)/models"/>
  <set_env name="IGN_GAZEBO_MODEL_PATH" value="$(find-pkg-share perse_simulation)/models"/>
  <set_env name="GAZEBO_PLUGIN_PATH" value="$(find-pkg-prefix perse_simulation)/lib/perse_simulation"/>


  <!-- Add Gazebo environment variables (fetched from /usr/share/gazebo/setup.bash) -->
  <set_env name="GAZEBO_RESOURCE_PATH" value="/usr/share/gazebo-11:$(env GAZEBO_RESOURCE_PATH)"/>
  <set_env name="GAZEBO_PLUGIN_PATH" value="/usr/lib/x86_64-linux-gnu/gazebo-11/plugins:$(env GAZEBO_PLUGIN_PATH)"/>
  <set_env name="GAZEBO_MODEL_PATH" value="/usr/share/gazebo-11/models:$(env GAZEBO_MODEL_PATH)"/>
  <set_env name="LD_LIBRARY_PATH" value="$(env LD_LIBRARY_PATH):$(env GAZEBO_PLUGIN_PATH)"/>
  <set_env name="OGRE_RESOURCE_PATH" value="/usr/lib/x86_64-linux-gnu/OGRE-1.9.0"/>

  <!-- launch gazebo -->
  <group>
    <arg name="world" default="$(find-pkg-share perse_simulation)/worlds/trekking_map.world"/>
    <arg name="gui" default="$(var gui)" />
    <arg name="server" default="$(var gui)" />
    <arg name="pause" default="$(var pause)"/>
    <arg name="record" default="$(var record)"/>

    <include file="$(find-pkg-share gazebo_ros)/launch/gazebo.launch.py" />
  </group>

</launch>
