<!-- Reference:
https://answers.ros.org/question/41433/multiple-robots-simulation-and-navigation/
http://wiki.ros.org/simulator_gazebo/Tutorials/Gazebo_ROS_API-->

<launch>

  <arg name="robot_number" default="1" />
  <arg name="team_number" default="0" />
  <arg name="robot_name" default="thunderwaze" />
  <arg name="x" default="0"/>
  <arg name="y" default="0"/>
  <arg name="z" default="0.4"/>
  <arg name="row" default="0"/>
  <arg name="pitch" default="0"/>
  <arg name="yaw" default="0"/>
  <arg name="model" default="$(find thunderwaze)/urdf/thunderwaze.xacro"/>

  <node name="keyboard_controller" pkg="thunderwaze" type="keyboard_node.py"/>

  <group ns="thunderwaze">

    <param name="robot_description"
      command="$(find xacro)/xacro $(arg model)" />

    <!-- push robot_description to factory and spawn robot in gazebo -->
    <node name="urdf_spawner" pkg="gazebo_ros" type="spawn_model"
          args="-x $(arg x) -y $(arg y) -z $(arg z)
                -R $(arg row) -P $(arg pitch) -Y $(arg yaw)
                -urdf -model $(arg robot_name) -param robot_description"
          respawn="false" output="screen" />

    <!-- Load configs to publish the state of all joints -->
    <rosparam command="load"
              file="$(find thunderwaze)/config/joints.yaml" />

    <!-- Load configs to control robot motors -->
    <!-- <rosparam command="load"
              file="$(find thunderwaze)/config/motor_drive.yaml" /> -->

    <!-- Load configs to control robot motors -->
    <rosparam command="load"
              file="$(find thunderwaze)/config/diff_drive.yaml" />

    <node name="robot_controller" pkg="controller_manager" type="spawner"
      args="robot_drive_controller
            robot_joint_state_controller"/>

  </group>
</launch>