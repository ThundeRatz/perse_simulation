<package format="2">
  <name>perse_simulation</name>
  <version>2.0.0</version>
  <description>
    <p>URDF Description package for Perse</p>
    <p>This package contains configuration data, 3D models and launch files
for Perse robot. The difference between 2.0.0 and 1.0.0 is mainly the migraition from ROS1 to ROS2.</p>
  </description>

  <author email="felipe.gomes@thunderatz.org">Felipe Gomes de Melo</author>
  <author email="giovanni.morales@thunderatz.org">Giovanni Toco Cabral</author>
  <maintainer email="felipe.gomes@thunderatz.org">Felipe Gomes de Melo</maintainer>
  <maintainer email="giovanni.morales@thunderatz.org">Giovanni Toco Cabral</maintainer>

  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>robot_state_publisher</depend>
  <depend>position_controllers</depend>
  <depend>velocity_controllers</depend>
  <depend>diff_drive_controller</depend>
  <depend>rviz2</depend>
  <depend>joint_state_publisher</depend>
  <depend>gazebo</depend>

  <build_depend>rclcpp</build_depend>
  <build_depend>geometry_msgs</build_depend>
  <build_depend>std_msgs</build_depend>
  <build_depend>rclpy</build_depend>
  <build_depend>gazebo_ros</build_depend>
  <build_depend>ros_gz_sim</build_depend>

  <build_export_depend>geometry_msgs</build_export_depend>
  <build_export_depend>rclpy</build_export_depend>

  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>rclcpp</exec_depend>
  <!-- <exec_depend>python-pygame</exec_depend> -->
  <exec_depend>gazebo_ros</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <architecture_independent/>
    <gazebo_ros plugin_path="${prefix}/../../lib" gazebo_media_path="${prefix}" />
  </export>
</package>
