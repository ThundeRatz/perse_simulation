<package format="2">
  <name>thunderwaze</name>
  <version>1.0.0</version>
  <description>
    <p>URDF Description package for ThunderWaze</p>
    <p>This package contains configuration data, 3D models and launch files
for ThunderWaze robot</p>
  </description>

  <author email="felipe.gomes@thunderatz.org">Felipe Gomes de Melo</author>
  <author email="giovanni.morales@thunderatz.org">Giovanni "Toco" Cabral</author>
  <maintainer email="felipe.gomes@thunderatz.org">Felipe Gomes de Melo</maintainer>
  <maintainer email="giovanni.morales@thunderatz.org">Giovanni "Toco" Cabral</maintainer>

  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>roslaunch</depend>
  <depend>robot_state_publisher</depend>
  <depend>position_controllers</depend>
  <depend>velocity_controllers</depend>
  <depend>diff_drive_controller</depend>
  <depend>rviz</depend>
  <depend>joint_state_publisher</depend>
  <depend>gazebo</depend>

  <build_depend>geometry_msgs</build_depend>
  <build_depend>rospy</build_depend>

  <build_export_depend>geometry_msgs</build_export_depend>
  <build_export_depend>rospy</build_export_depend>

  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>rospy</exec_depend>
  <exec_depend>python-pygame</exec_depend>

  <export>
    <architecture_independent />
  </export>
</package>