<?xml version="1.0"?>

<!-- Ref: http://gazebosim.org/tutorials/?tut=ros_urdf
    http://answers.gazebosim.org/question/13506/preventing-bouncing-of-object/
    -->

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- Body -->
    <gazebo reference="base_link">
        <mu1 value="0.2"/>
        <mu2 value="0.2"/>
        <kp value="1e12" />
        <kd value="1.0" />
    </gazebo>

    <!-- Wheels -->
    <xacro:macro name="wheel" params="link_name">
        <gazebo reference="${link_name}_link">
            <mu1 value="2.0"/> <!-- Coulomb friction coefficient -->
            <mu2 value="2.0"/> <!-- Coulomb friction coefficient -->
            <kp value="1e12" /> <!-- Contact stiffness  -->
            <kd value="1.0" /> <!-- Contact damping  -->
            <minDepth value="1e-1" /> <!-- Minimum allowable depth before contact correction -->
        </gazebo>
    </xacro:macro>

    <xacro:wheel link_name="wheel_front_right"/>
    <xacro:wheel link_name="wheel_front_left"/>
    <xacro:wheel link_name="wheel_back_right"/>
    <xacro:wheel link_name="wheel_back_left"/>

    <!-- Load gazebo plugin to control the robot -->
    <gazebo>
        <plugin name="gazebo_ros_control" filename="libgazebo_ros_control.so">
            <robotNamespace>/perse</robotNamespace>
        </plugin>
    </gazebo>
    
     <!-- camera -->
    <!-- <gazebo reference="cam_link">
        <sensor type="camera" name="camera1">
        <visualize>true</visualize>
        <update_rate>120</update_rate>
