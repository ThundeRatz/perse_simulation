<?xml version="1.0" encoding="utf-8"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <gazebo reference="base_link">
        <material>
            <script>
                <uri>model://Perse/materials/scripts/</uri>
                <name>Perse/Base</name>
            </script>
        </material>
    </gazebo>

    <gazebo reference="chasis_link">
        <material>
            <script>
                <uri>model://Perse/materials/scripts/</uri>
                <name>Perse/Chasis</name>
            </script>
        </material>
    </gazebo>

    <gazebo reference="wheel_front_left_link">
        <material>Gazebo/FlatBlack</material>
    </gazebo>

    <gazebo reference="wheel_front_right_link">
        <material>Gazebo/FlatBlack</material>
    </gazebo>

    <gazebo reference="wheel_back_right_link">
        <material>Gazebo/FlatBlack</material>
    </gazebo>

    <gazebo reference="wheel_back_right_link">
        <material>Gazebo/FlatBlack</material>
    </gazebo>

    <gazebo reference="wheel_back_left_link">
        <material>Gazebo/FlatBlack</material>
    </gazebo>

    <gazebo reference="bumper_link">
        <material>
            <script>
                <uri>model://Perse/materials/scripts/</uri>
                <name>Perse/Bumper</name>
            </script>
        </material>
    </gazebo>

    <gazebo reference="cover_link">
        <material>
            <script>
                <uri>model://Perse/materials/scripts/</uri>
                <name>Perse/Cover</name>
            </script>
        </material>
    </gazebo>

    <gazebo reference="batt_holder_link">
        <material>
            <script>
                <uri>model://Perse/materials/scripts/</uri>
                <name>Perse/BattHolder</name>
            </script>
        </material>
    </gazebo>

    <gazebo reference="batt_link">
        <material>Gazebo/Blue</material>
    </gazebo>

    <gazebo reference="cam_holder_link">
        <material>Gazebo/Gray</material>
    </gazebo>

    <gazebo reference="cam_link">
        <material>Gazebo/Black</material>
    </gazebo>

</robot>
