<?xml version="1.0"?>

<!-- Ref: http://gazebosim.org/tutorials/?tut=ros_urdf
    http://answers.gazebosim.org/question/13506/preventing-bouncing-of-object/
    -->

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- Body -->
    <gazebo reference="base_link">
        <mu1 value="0.2"/>
        <mu2 value="0.2"/>
        <kp value="1e12" />
        <kd value="1.0" />
    </gazebo>

    <!-- Wheels -->
    <xacro:macro name="wheel" params="link_name">
        <gazebo reference="${link_name}_link">
            <mu1 value="2.0"/> <!-- Coulomb friction coefficient -->
            <mu2 value="2.0"/> <!-- Coulomb friction coefficient -->
            <kp value="1e12" /> <!-- Contact stiffness  -->
            <kd value="1.0" /> <!-- Contact damping  -->
            <minDepth value="1e-1" /> <!-- Minimum allowable depth before contact correction -->
        </gazebo>
    </xacro:macro>

    <xacro:wheel link_name="wheel_front_right"/>
    <xacro:wheel link_name="wheel_front_left"/>
    <xacro:wheel link_name="wheel_back_right"/>
    <xacro:wheel link_name="wheel_back_left"/>

    <!-- Load gazebo plugin to control the robot -->
    <ros2_control name="GazeboSystem" type="system">
      <hardware>
        <plugin>gazebo_ros2_control/GazeboSystem</plugin>
      </hardware>
      <!-- front wheels -->
      <joint name="wheel_front_left_joint">
        <command_interface name="velocity">
          <param name="min">-100</param>
          <param name="max">100</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      <joint name="wheel_front_right_joint">
        <command_interface name="velocity">
          <param name="min">-100</param>
          <param name="max">100</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>

      <!-- back wheels -->
      <joint name="wheel_back_left_joint">
        <command_interface name="velocity">
          <param name="min">-100</param>
          <param name="max">100</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      <joint name="wheel_back_right_joint">
        <command_interface name="velocity">
          <param name="min">-100</param>
          <param name="max">100</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>

      <!-- bumper -->
      <joint name="bumper_joint">
        <!-- <state_interface name="position"/> -->
        <!-- <state_interface name="velocity"/> -->
      </joint>
    </ros2_control>

    <gazebo>
        <plugin filename="libgazebo_ros2_control.so" name="gazebo_ros2_control">
            <!-- <robot_param>/perse/robot_description</robot_param> -->
            <!-- <robot_param_node>/perse/robot_state_publisher</robot_param_node> -->
            <!-- Push perse namespace -->
           <ros>
               <!-- <namespace>perse</namespace> -->
               <!-- <remapping>/tf:=/perse/tf</remapping> -->
               <remapping>/diff_drive_base_controller/cmd_vel_unstamped:=/perse/actuator/cmd_vel</remapping>
               <remapping>/diff_drive_base_controller/odom:=/perse/odom</remapping>
           </ros> 
            <parameters>$(find perse_simulation)/config/diff_drive.yaml</parameters>
        </plugin>

    </gazebo>
    
     <!-- camera -->
    <gazebo reference="cam_link">
        <sensor type="camera" name="camera1">
        <visualize>true</visualize>
        <update_rate>120</update_rate>
        <camera name="head">
            <horizontal_fov>1.3962634</horizontal_fov>
            <image>
                <width>480</width>
                <height>360</height>
                <format>R8G8B8</format>
            </image>
            <clip>
                <near>0.08</near>
                <far>300</far>
            </clip>
            <noise>
                <type>gaussian</type>
                <mean>0.0</mean>
                <stddev>0.007</stddev>
            </noise>
        </camera>
        <plugin name="camera_controller" filename="libgazebo_ros_camera.so">
            <alwaysOn>true</alwaysOn>
            <updateRate>120</updateRate>
            <cameraName>camera</cameraName>
            <imageTopicName>image_raw</imageTopicName>
            <cameraInfoTopicName>camera_info</cameraInfoTopicName>
            <frameName>camera_link</frameName>
            <hackBaseline>0.07</hackBaseline>
            <distortionK1>0.0</distortionK1>
            <distortionK2>0.0</distortionK2>
            <distortionK3>0.0</distortionK3>
            <distortionT1>0.0</distortionT1>
            <distortionT2>0.0</distortionT2>
        </plugin>
        </sensor>
    </gazebo>

    <!-- IMU  -->
    <gazebo reference="imu_link">
        <gravity>true</gravity>
        <sensor name="my_imu" type="imu">
            <!-- ensure the sensor is active (required) -->
            <always_on>true</always_on>
            <update_rate>30</update_rate>
            <plugin name="imu_plugin" filename="libgazebo_ros_imu_sensor.so">
                <ros>
                    <!-- publish to /perse/sensors/imu -->
                    <namespace>/perse/sensors</namespace>
                    <remapping>~/out:=imu</remapping>
                </ros>
            </plugin>
        </sensor>
    </gazebo>


    <!-- inductive sensor plugin-->

    <!-- Load odometry_variables.yaml at perse_simulation -->
    <xacro:property name="yaml_file" value="$(find perse_simulation)/config/odometry_variables.yaml" />
    <xacro:property name="yaml_props" value="${xacro.load_yaml(yaml_file)}" />
    <!-- Extract the actual parameters-->
    <xacro:property name="odometry_variables" value="${yaml_props['decision_node']['ros__parameters']}" />

    <!-- This macro receives a list as parameter and calls itself recursively, removing the first element and using it as index to each point -->
    <!-- Example of expanded macro -->
    <!-- <parameter name="p1.x" type="double">1.0</parameter> -->
    <!-- <parameter name="p1.y" type="double">2.0</parameter> -->
    <xacro:macro name="point_parameters" params="points:=^">
            <xacro:if value="${points}">
                    <!-- pop first item from list -->
                    <xacro:property name="index" value="${points.pop(0)}"/>

                    <parameter name="p${index}.x" type="double">${odometry_variables['p'+str(index)]['x']}</parameter>
                    <parameter name="p${index}.y" type="double">${odometry_variables['p'+str(index)]['y']}</parameter>

                    <!-- recursively call myself -->
                    <xacro:point_parameters/>
            </xacro:if>
    </xacro:macro>


    <gazebo>
        <plugin name="inductive_sensor" filename="libinductive_sensor_plugin.so">
            <topicName>perse/sensors/inductive_sensor</topicName>
            <ros>

                <!-- declare the number_of_points -->
                <parameter name="number_of_points" type="int">${odometry_variables['number_of_points']}</parameter>

                <!-- call recursive macro to generate each point parameter -->
                <xacro:point_parameters points="${list(python.range(1, odometry_variables['number_of_points']+1))}" />
            </ros>
        </plugin>
    </gazebo>

    <!-- encoder plugin-->
    <gazebo>
        <plugin name="encoder" filename="libencoder_plugin.so">
            <topicName>perse/sensors/encoder</topicName>
            <resolution>2</resolution>
            <wheelRadius>0.06</wheelRadius>
            <leftWheelJointName>wheel_front_left_joint</leftWheelJointName>
            <rightWheelJointName>wheel_front_right_joint</rightWheelJointName>
        </plugin>
    </gazebo>

    <!-- bumper plugin -->
    <gazebo>
        <plugin name="bumper" filename="libbumper_plugin.so">
            <topicName>perse/sensors/bumper</topicName>
            <triggerPosition>0.02</triggerPosition>
            <jointName>bumper_joint</jointName>
            <jointForce>2</jointForce>
        </plugin>
    </gazebo>
</robot>
